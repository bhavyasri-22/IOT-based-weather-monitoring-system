# =============================================================================
# 🌦️ IoT Weather Monitoring Frontend - Environment Configuration Template
# Copy this file to `.env` and configure for your deployment.
# =============================================================================

# ── Local Development ────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:5001/api
VITE_WS_URL=ws://localhost:5001
VITE_DEFAULT_DEVICE_ID=ESP32-NODE-01

# ── Production Cloud Deployment (e.g. Vercel, Netlify, Render) ───────────────
# When deployed to a cloud platform, set these environment variables in your hosting dashboard:
# VITE_API_BASE_URL=https://your-backend-api.onrender.com/api
# VITE_WS_URL=wss://your-backend-api.onrender.com
# VITE_DEFAULT_DEVICE_ID=ESP32-NODE-01
