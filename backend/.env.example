# Backend Environment Configuration Template
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/weather_db
MQTT_BROKER_URL=mqtt://127.0.0.1:1883
JWT_SECRET=your_super_secret_jwt_key_here
DEVICE_API_KEY=your_device_api_key_here
DEVICE_OFFLINE_TIMEOUT_MS=120000
DEVICE_HEALTH_CHECK_INTERVAL_MS=10000
SAMPLE_INTERVAL_MS=5000

# ── Cloud Deployment (Render) ──
# Set ENABLE_EMBEDDED_BROKER=true to run Aedes MQTT broker inside this server
# ENABLE_EMBEDDED_BROKER=true
# MQTT_BROKER_URL=ws://localhost:10000/mqtt
# PORT=10000
# CORS_ORIGIN=https://your-frontend.vercel.app
# NODE_ENV=production
