# =============================================================================
# 🌦️ IoT Weather Monitoring Backend - Environment Configuration Template
# Copy this file to `.env` and fill in the values for your environment.
# =============================================================================

# ── General Server Settings ──────────────────────────────────────────────────
NODE_ENV=development
PORT=5001
HOST=0.0.0.0

# ── Database (MongoDB Atlas or Local MongoDB) ─────────────────────────────────
# For Local Dev: mongodb://127.0.0.1:27017/weather_db
# For Production: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/weather_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/weather_db

# ── Cloud MQTT Broker Settings ───────────────────────────────────────────────
# Option A: Full Connection URL
# For Local Dev: mqtt://127.0.0.1:1883
# For Cloud TLS: mqtts://<username>:<password>@<broker-host>.hivemq.cloud:8883
MQTT_BROKER_URL=mqtt://127.0.0.1:1883

# Option B: Discrete Configuration (Takes effect if MQTT_BROKER_URL is omitted)
# MQTT_HOST=your-cluster.hivemq.cloud
# MQTT_PORT=8883
# MQTT_USERNAME=weather_backend_consumer
# MQTT_PASSWORD=YourSecurePassword123
# MQTT_USE_TLS=true
# MQTT_REJECT_UNAUTHORIZED=true

# ── Authentication & Security ────────────────────────────────────────────────
# Secret used for signing JWT access tokens (Must be kept secure in production)
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_in_production

# Global API Key used for Hardware HTTPS Ingestion Fallback (SRS F.4)
DEVICE_API_KEY=replace_with_a_secure_device_api_key

# ── CORS Policy (Frontend Allowed Origins) ────────────────────────────────────
# In Development: '*'
# In Production: https://your-weather-dashboard.vercel.app,https://yourdomain.com
CORS_ORIGIN=*

# ── Ingestion & Health Engine Timers (Milliseconds) ──────────────────────────
DEVICE_OFFLINE_TIMEOUT_MS=120000
DEVICE_HEALTH_CHECK_INTERVAL_MS=10000
SAMPLE_INTERVAL_MS=5000

# ── Optional: Embedded MQTT Broker (For single-container/Render fallback) ────
# Set to 'true' only if you want the backend to host an internal MQTT-over-WS broker on /mqtt
ENABLE_EMBEDDED_BROKER=false
