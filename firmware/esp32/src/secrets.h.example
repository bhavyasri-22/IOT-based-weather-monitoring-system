#ifndef SECRETS_H
#define SECRETS_H

// =============================================================================
// ⚙️ ESP32 WEATHER STATION - CONFIGURATION TEMPLATE
// Copy this file to `secrets.h` and configure for your environment.
// DO NOT COMMIT YOUR ACTUAL `secrets.h` FILE TO VERSION CONTROL.
// =============================================================================

// ── Wi-Fi Configuration ──────────────────────────────────────────────────────
// The ESP32 can connect to any Wi-Fi network with Internet access (Home, College, Hotspot)
static const char* WIFI_SSID             = "YOUR_WIFI_SSID";
static const char* WIFI_PASS             = "YOUR_WIFI_PASSWORD";

// ── MQTT Broker Configuration ────────────────────────────────────────────────
// For Local Dev: "192.168.1.xxx" (Port 1883, MQTT_USE_TLS = false)
// For Cloud Production: "your-cluster.hivemq.cloud" or "broker.emqx.io" (Port 8883, MQTT_USE_TLS = true)
static const char* MQTT_SERVER           = "your-broker.hivemq.cloud";
static const int   MQTT_PORT             = 8883;
static const bool  MQTT_USE_TLS          = true;

// MQTT Authentication (Leave empty strings "" if using an open broker without authentication)
static const char* MQTT_USER             = "weather_node_01";
static const char* MQTT_PASS             = "YourSecureMqttPassword123";

// ── Hardware & Topic Identifiers ─────────────────────────────────────────────
static const char* DEVICE_ID             = "ESP32-NODE-01";
static const char* MQTT_TELEMETRY_TOPIC  = "weather/telemetry";
static const char* MQTT_HEARTBEAT_TOPIC  = "weather/heartbeat";
static const unsigned long TELEMETRY_INTERVAL_MS = 5000;

// ── HTTPS Fallback Transport (SRS F.4) ───────────────────────────────────────
// Optional secondary ingestion endpoint if MQTT broker is unreachable
static const bool  ENABLE_HTTPS_FALLBACK = false;
static const char* BACKEND_INGEST_URL    = "https://your-backend-api.com/api/telemetry/ingest";
static const char* DEVICE_API_KEY        = "your_device_api_key_here";

#endif // SECRETS_H
